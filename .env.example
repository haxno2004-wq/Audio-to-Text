# Paste your keys after the = sign. No quotes, no spaces. A model with no key is skipped.
# Local Whisper + Deepgram + AssemblyAI gives 3 models, enough for real majority voting.

# ---- Local model: faster-whisper (no key needed) ----
WHISPER_ENABLED=1
WHISPER_MODEL=large-v3          # "turbo" or "medium" are much faster on a laptop CPU
WHISPER_DEVICE=cpu              # cpu | cuda (NVIDIA GPU, see README)
WHISPER_COMPUTE=int8            # int8 on CPU; float16 on GPU
WHISPER_BEAM=5

# ---- Deepgram ----
DEEPGRAM_API_KEY=755f29372bf802392dc5a7caa5355531a64b276f
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=detect        # detect | multi (code-switching, 10 languages) | en, hi, ...

# ---- AssemblyAI ----
ASSEMBLYAI_API_KEY=bc966943be1d40a18beeaa9e32425a54
ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2

# ---- Tuning ----
# MODEL_WEIGHTS=whisper=1.2,deepgram=1,assemblyai=1
CONSENSUS_WINDOW_SECONDS=30
MAX_UPLOAD_MB=500
