# Trading agent configuration (paper mode by default)
TRADING_CAPITAL=500
TRADE_PAIR=BTCINR
POLL_MINUTES=15

# Risk guardrails
MAX_POSITION_FRAC=0.5
MAX_INR_POSITION=250
DAILY_MAX_LOSS_FRAC=0.05
MAX_TRADES_PER_DAY=3
COOLDOWN_MINUTES=240

# Strategy knobs (slow on purpose)
TRADE_EMA_FAST=12
TRADE_EMA_SLOW=48
TRADE_BREAKOUT_BARS=24
TRADE_CONFIRM_BARS=3
TRADE_ATR_BARS=14
TRADE_ATR_STOP=2.5

# Credentials: only needed for LIVE_MODE. Prefer a file or your secrets
# manager; never commit them. Create the key with TRADE permission only and
# withdrawals DISABLED, IP-whitelisted to your machine.
# COINDCX_API_KEY=
# COINDCX_API_SECRET=
# LIVE_MODE=0
